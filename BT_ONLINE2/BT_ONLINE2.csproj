<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Nếu là Windows (máy trường) thì tự chọn net6.0, ngược lại (macOS ở nhà) tự chọn net9.0 -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net6.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

</Project>